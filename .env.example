# Copy to .env and adjust as needed. Picked up automatically by the
# Justfile (set dotenv-load) and by Bun.serve() at runtime (PORT).

# Port the server listens on, and that Docker maps to the host.
PORT=3000

# Local Docker image/container naming (used by the `just docker-*` recipes).
IMAGE_NAME=akiidjk-portfolio
IMAGE_TAG=latest
CONTAINER_NAME=akiidjk-portfolio
